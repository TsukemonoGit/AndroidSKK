<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Tab bar: Emoji / Symbols + Back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/emoji_tab_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/colorBackground" />

        <ImageButton
            android:id="@+id/emoji_back_button"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_keyboard_return"
            android:contentDescription="@string/descr_close_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Content area -->
    <FrameLayout
        android:id="@+id/emoji_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Emoji picker from AndroidX -->
        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Symbol grid -->
        <LinearLayout
            android:id="@+id/symbol_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Symbol category tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/symbol_category_tabs"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="?android:attr/colorBackground"
                app:tabMode="scrollable"
                app:tabGravity="start" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/symbol_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="4dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
