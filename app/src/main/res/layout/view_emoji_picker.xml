<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/emoji_search_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/emoji_search_edit"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:hint="@string/emoji_picker_search_hint"
            android:singleLine="true"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/popup_bg"
            android:importantForAutofill="no"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/emoji_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_keyboard_return"
            android:contentDescription="@string/descr_close_button"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Tab bar: Emoji / Symbols -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/emoji_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?android:attr/colorBackground" />

    <!-- Content area -->
    <FrameLayout
        android:id="@+id/emoji_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Emoji picker from AndroidX -->
        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Symbol grid -->
        <LinearLayout
            android:id="@+id/symbol_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Symbol category tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/symbol_category_tabs"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="?android:attr/colorBackground" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/symbol_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="4dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
